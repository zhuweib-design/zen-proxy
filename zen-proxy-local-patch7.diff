+// Upstream moved to OpenAI/Anthropic-compatible prefixes: inference now lives
+// under /inference/openai/v1 and /inference/anthropic/v1, while the model
+// catalog stayed on /inference/v1/models. The old /inference/v1 inference path
+// still answers, but only by upstream grace, so it is treated as legacy.
+const DEFAULT_UPSTREAM = "https://opencode.ai/inference/openai/v1"
+const DEFAULT_CATALOG = "https://opencode.ai/inference/v1/models"
+const LEGACY_UPSTREAMS = new Set([
+  "https://opencode.ai/zen/v1",
+  "https://opencode.ai/zen",
+  "https://opencode.ai/inference/v1",
+])
 function normalizeUpstream(v) {
   const u = String(v ?? "").trim().replace(/\/+$/, "")
   if (!u) return DEFAULT_UPSTREAM
   return LEGACY_UPSTREAMS.has(u.toLowerCase()) ? DEFAULT_UPSTREAM : u
 }
 
+// The catalog address cannot be derived by appending /models to the inference
+// one any more (that yields /inference/openai/v1/models, which is 404). Drop
+// the /openai segment but keep the version: /inference/openai/v1 ->
+// /inference/v1 -> /inference/v1/models. catalogUrl overrides entirely.
+function catalogUrl() {
+  if (config.catalogUrl) return String(config.catalogUrl).replace(/\/+$/, "")
+  const u = String(config.upstream || "").replace(/\/+$/, "")
+  return `${u.replace(/\/openai(?=\/v\d+$)/, "")}/models`
+}
+
