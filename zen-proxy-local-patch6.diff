+// Turns one probe result into a health bucket. Split out of syncModels so the
+// rules can be exercised with synthetic input (check-probe-classify.mjs):
+// every one of these branches has, at some point, retired a live model, and
+// none of that is catchable without a network.
+//   status  HTTP status from the probe; 0 means the request never completed
+//   bodyErr "<error.type> <error.message>" from the body, empty when none
+//   listed  the upstream /models catalog still advertises this id
+//   fails   consecutive count carried over from previous rounds
+// Returns { bucket, fails, drop }. Only drop=true may remove a model from the
+// user's configured list, which is the one outcome that is not self-healing.
+function classifyProbe(status, bodyErr, listed, fails) {
+  const says = (re) => re.test(bodyErr)
+  if (status >= 200 && status < 300 && !bodyErr) return { bucket: "working", fails: 0, drop: false }
+  // 429 is quota, always. The old rule required the body to carry no error,
+  // but "free usage limit reached" arrives as a 429 *with* an error body, so
+  // quota exhaustion fell through to the failure counter and six live models
+  // were reported as gone.
+  if (status === 429) return { bucket: "rateLimited", fails: 0, drop: false }
+  // A key problem is not a model problem.
+  if (says(/AuthError|invalid api key|missing api key/i)) return { bucket: "flaky", fails, drop: false }
+  // The gate refusing an agent-shaped probe says nothing about the model.
+  if (says(/FreeTierError|free tier can only/i)) return { bucket: "gated", fails, drop: false }
+  // Known temporary conditions: keep the model, clear its counter.
+  if (says(/RegionError|not available in your country|usage limit|limit reached|quota|too many requests|rate.?limit|overloaded/i)) {
+    return { bucket: "flaky", fails: 0, drop: false }
+  }
+  // Retiring is the irreversible-ish move, so it needs the catalog's agreement:
+  // while /models still lists the id, a 404 or a repeated error is treated as
+  // ill health and the model stays configured. Upstream can also answer 4xx
+  // for models it happily advertises, and a short or partial /models response
+  // must not be allowed to mass-delete the list in one round.
+  if (listed) return { bucket: "flaky", fails, drop: false }
+  const next = fails + 1
+  if (next >= 3) return { bucket: "dead", fails: next, drop: true }
+  return { bucket: "flaky", fails: next, drop: false }
+}
